{
  "name": "priority-gate",
  "version": "0.1.0",
  "description": "Filter events before expensive downstream calls. Drop, log, escalate, direct.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit && node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "event-filter",
    "rule-engine",
    "priority-gate",
    "llm",
    "agent",
    "iot",
    "telemetry"
  ],
  "author": "Craig Thomas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/craigt672/priority-gate.git"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
